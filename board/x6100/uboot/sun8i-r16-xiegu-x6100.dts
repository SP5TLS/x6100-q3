/*
 * Xiegu X6100: the little U-Boot needs to load Linux from the SD card.
 * The full board description lives in the kernel tree
 * (board/x6100/dts/allwinner/sun8i-r16-xiegu-x6100.dts); U-Boot only
 * brings up the PMIC, the console and the two MMC controllers.
 */

/dts-v1/;

#include "sun8i-a33.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Xiegu X6100";
	compatible = "xiegu,x6100", "allwinner,sun8i-r16", "allwinner,sun8i-a33";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
		mmc1 = &mmc2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&mmc0 {
	vmmc-supply = <&reg_dcdc1>;
	bus-width = <4>;
	cd-gpios = <&pio 4 3 GPIO_ACTIVE_LOW>; /* PE3 */
	status = "okay";
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	vmmc-supply = <&reg_dcdc1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status = "okay";
};

&r_rsb {
	status = "okay";

	axp22x: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&r_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		eldoin-supply = <&reg_dcdc1>;
	};
};

#include "axp223.dtsi"

&reg_dcdc1 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "vcc-3v0";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};
