# X6100 additions on top of arch/arm/configs/sunxi_defconfig.

CONFIG_LOCALVERSION="-x6100"
# CONFIG_LOCALVERSION_AUTO is not set

# Scheduling: a responsive launcher and game on four A7 cores.
CONFIG_PREEMPT=y
CONFIG_HZ_250=y
# Fixed 1.2 GHz by default, for the game; schedutil saves battery
# (CPU_GOVERNOR in x6100.conf).
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CMA_SIZE_MBYTES=32

# Root filesystem stays read-only; /etc and /var/lib are overlays on /data.
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y

# Not used on the X6100.
# CONFIG_ROOT_NFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CAN is not set
# CONFIG_SUN4I_EMAC is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_ATA is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_DRM_SUN8I_DW_HDMI is not set
# CONFIG_DRM_SUN4I_HDMI_CEC is not set
# CONFIG_IP_PNP is not set

# Networking for NetworkManager, wpa_supplicant, avahi and the web page.
CONFIG_IPV6=y
CONFIG_INET_DIAG=y
CONFIG_NETFILTER=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_DEFAULT_PS=n
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=m
CONFIG_MAC80211_LEDS=n
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=n
# Internal module: RTL8723BU on the OTG port (Wi-Fi function). Modules,
# so firmware and regulatory.db load after the root filesystem is up.
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
# Some boards carry the SDIO RTL8723BS instead.
CONFIG_STAGING=y
CONFIG_RTL8723BS=m
# Common USB Wi-Fi / Ethernet adapters on the external USB port.
CONFIG_RTL8192CU=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_MT7601U=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m

# Crypto used by wpa_supplicant (WPA3/SAE), cfg80211 regdb signatures.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_ECDH=y
CONFIG_KEYS=y

# Bluetooth: btusb + btrtl for the RTL8723BU, audio, HID (keyboards and
# mice, classic and LE).
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_POLL_SYNC=y
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=n
CONFIG_BT_RTL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_RTL=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_UINPUT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y

# USB: musb host for the internal module, EHCI/OHCI for the USB-A port.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_HOST=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_HID=y
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_SND_USB_AUDIO=m
# CONFIG_USB_GADGET is not set

# Display: TCON0 RGB666 -> JLT4013A (ST7701S, command bus over spi-gpio).
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_SPI_GPIO=y
# GPU: Mali-400 MP2 (lima) for Mesa, rendering into buffers the sun4i
# display driver scans out. Powered from VDD-SYS (DCDC2); DCDC4, named
# vdd-gpu in the stock device tree, is unused on A33 boards and U-Boot
# switches it off. Clock 144-384 MHz by devfreq.
CONFIG_DRM_LIMA=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_SUN4I=y
# Boot logo (the kernel's own) on the framebuffer console; the console
# text itself goes to the serial port only.
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n
CONFIG_LOGO=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Input: keypad matrix, encoders, AXP223 power key.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_MATRIX=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_ROTARY_ENCODER=y
CONFIG_INPUT_AXP20X_PEK=y
# CONFIG_KEYBOARD_SUN4I_LRADC is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# Bit-banged I2C (clock; BASE board, for power-off), sysfs GPIOs set at
# boot (CW key up, BASE out of reset, key backlight).
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_I2C_ALGOBIT=y
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y
CONFIG_GPIO_CDEV=y
CONFIG_SERIAL_8250_DW=y

# Battery-backed clock.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_RTC_DRV_SUN6I=y

# Audio: USB sound cards and PipeWire (Bluetooth). The A33 codec is off in
# the device tree: its output is the transmitter's modem input.
CONFIG_SND=y
CONFIG_SND_HRTIMER=y

# Firmware for the Wi-Fi/Bluetooth module is loaded from /lib/firmware.
CONFIG_FW_LOADER=y

# Misc.
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
# No CPU temperature sensor: on the A33 it is the GPADC's (sun4i-gpadc),
# which reads noise here (-5..87 C within seconds) and would make the
# cpu-thermal zone throttle or power off at random.
# CONFIG_SUN4I_GPADC is not set
CONFIG_LEDS_CLASS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSI=y
