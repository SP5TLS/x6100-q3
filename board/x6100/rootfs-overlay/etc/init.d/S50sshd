#!/bin/sh
# OpenSSH server. Host keys are made on the first boot (kept on /data via
# the /etc overlay). That takes a while on this CPU, so it runs in the
# background instead of holding up the launcher's start.

DAEMON=sshd
PIDFILE=/var/run/$DAEMON.pid

[ -x /usr/sbin/sshd ] || exit 0
umask 077

start() {
	printf 'Starting %s: ' "$DAEMON"
	(
		/usr/bin/ssh-keygen -A >/dev/null 2>&1
		start-stop-daemon -S -q -p "$PIDFILE" -x /usr/sbin/sshd
	) &
	echo "OK"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon -K -q -p "$PIDFILE" -x /usr/sbin/sshd
	echo "OK"
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
reload) start-stop-daemon -K -s HUP -q -p "$PIDFILE" -x /usr/sbin/sshd ;;
*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
exit 0
