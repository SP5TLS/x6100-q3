# /etc/inittab for x6100-q3 (BusyBox init).
#
# BusyBox init, not systemd: x6100-poweroff ends with SIGUSR2 to PID 1,
# which BusyBox init takes as "power off".

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# The launcher (screen, web page, the game): restarted whenever it exits.
::respawn:/usr/libexec/x6100/launcher-run

# Serial console (USB-C, first port; test pads), 115200 8N1.
ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100

# The BASE board removes power about 5 s after x6100-poweroff asks it
# to: flush first, then stop services, then unmount.
::shutdown:/bin/sync
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
